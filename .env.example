# Copy to .env and adjust. NEVER commit the real .env.
POSTGRES_USER=lisa
POSTGRES_PASSWORD=lisa
POSTGRES_DB=lisa

# Used by the backend when run outside compose (e.g. locally):
DATABASE_URL=postgresql+psycopg://lisa:lisa@localhost:5432/lisa
REDIS_URL=redis://localhost:6379/0

# Panel (operator) auth. Leave OPERATOR_PASSWORD unset for an open panel in
# dev; set it to require operator login. JWT_SECRET signs the login tokens —
# optional (derived from OPERATOR_PASSWORD when unset), but set a dedicated
# random value in production.
OPERATOR_PASSWORD=
JWT_SECRET=

# Shared secret agents send as "Authorization: Bearer <token>". Unset = open.
AGENT_TOKEN=

# OS targets the backend will queue builds for. Add "macos" once a macOS build
# worker is running (see docs/deployment.md). Nuitka can't cross-compile.
BUILDABLE_OS=["linux"]

# Where built artefacts are stored/served. Bind-mounted into backend+builder and
# used by out-of-container workers (macOS/Windows) so they share one directory.
# Defaults to ./.builds in the repo; set an absolute path to store elsewhere.
LISA_BUILDS_DIR=

# LISA agent configuration.
# Copy to .env and adjust. NEVER commit the real .env (it's gitignored).
# All values below are read by lisa_agent/config.py at startup.

# Backend the agent talks to (heartbeat, config fetch).
LISA_BACKEND_URL=http://localhost:8000

# Auth token for the backend. Keep this secret - never hardcode in source.
# Leave empty for local dev against an unauthenticated backend.
LISA_AGENT_TOKEN=

# How often the agent reports its status, in minutes.
LISA_HEARTBEAT_INTERVAL_MINUTES=30

# Simulated work hours (local time, HH:MM). Agent is idle outside these.
LISA_WORK_START=09:00
LISA_WORK_END=18:00

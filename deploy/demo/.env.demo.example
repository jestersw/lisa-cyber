# Copy to deploy/demo/.env.demo and fill in. .env.demo is gitignored — it holds
# real secrets. Generate the secrets with:  openssl rand -base64 32

# Public hostname Caddy serves + gets a TLS cert for. With no domain, use a
# wildcard-DNS name that resolves to your server's public IP, e.g.:
#   DEMO_DOMAIN=203.0.113.10.nip.io
# (nip.io/sslip.io resolve <ip>.nip.io -> <ip>, so Let's Encrypt can issue.)
DEMO_DOMAIN=

# Panel login password (operators type this to sign in). REQUIRED.
OPERATOR_PASSWORD=

# Signs panel session tokens. REQUIRED. Use a long random value.
JWT_SECRET=

# Postgres password. REQUIRED (no dev default in the demo compose).
POSTGRES_PASSWORD=

# Optional: lock the agent-facing endpoints (/api/agents/heartbeat, /events).
# The Range simulator does not need it; set it to a random value as defence in
# depth, or leave blank for the demo.
AGENT_TOKEN=

# Optional overrides (sensible defaults otherwise).
# POSTGRES_USER=lisa
# POSTGRES_DB=lisa
# BUILDABLE_OS=["linux"]
